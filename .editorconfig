root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,c,cc,cpp,h,hh,hpp,inl,gradle,kts,xml,py,cmake}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,html}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4
